---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { getBuiltCruxes, verseLabel } from "../lib/data";

const cruxes = getBuiltCruxes().sort((a, b) => a.verse.localeCompare(b.verse) || a.id.localeCompare(b.id));
---
<Layout title="Bereshit / In Principio" prose>
  <div class="wrap">
    <SiteHeader active="/" />
    <h1 class="title">Bereshit / In Principio</h1>
    <p class="subtitle">
      Genesis 1:1–5, read as ten cruxes — a difficulty the Latin, the rabbinic and the
      Greek-Jewish traditions each addressed — with every witness on each dated, sourced, and
      threaded to the ones it cites, echoes, contests, transmits, or merely runs parallel to.
    </p>
    <p class="subtitle" style="margin-top:-6px">
      Three benches, not two: the Latin, the rabbinic, and the Greek-Jewish, which holds the
      Septuagint and Philo. Where the two larger benches meet at all they mostly meet without knowing
      it; on one page they are audibly in the same room. <a href="/introduction/">The introduction</a>
      says what the ten findings add up to.
    </p>
    <ul class="crux-list">
      {cruxes.map((c) => (
        <li>
          <span class="verse-tag">{verseLabel(c.verse)}</span>
          <div>
            <a class="ck" href={`/crux/${c.id}/`}>{c.question.en}</a>
            {c.short && <span class="short"> — {c.short}</span>}
          </div>
          <p class="q">{c.summary}</p>
          {c.finding && <p class="finding">{c.finding.split("\n\n")[0]}</p>}
        </li>
      ))}
    </ul>
  </div>
</Layout>
