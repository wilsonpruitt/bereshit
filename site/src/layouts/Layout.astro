---
import "../styles/daf.css";
import "../styles/site.css";

interface Props {
  title: string;
  prose?: boolean;
}
const { title, prose = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@400;500;600&family=Frank+Ruhl+Libre:wght@400;500;700&display=swap"
    />
  </head>
  <body class={prose ? "prose" : ""} data-pagefind-body>
    <slot />
  </body>
</html>
